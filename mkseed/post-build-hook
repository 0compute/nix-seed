#!/usr/bin/env bash

set -euo pipefail

# Nix daemon passes these variables:
# $OUT_PATHS: Space-separated list of build outputs
# $DRV_PATH: The .drv file that produced them

derivation=$(
  nix derivation show "$DRV_PATH" --json |
    jq --arg DRV_PATH "$DRV_PATH" '.[$DRV_PATH]'
)

