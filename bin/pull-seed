#!/usr/bin/env bash
# shellcheck disable=2086

set -eux -o pipefail

dir=${1:-.}
out=${2:?artifact output dir required}
layout=${3:?oci layout cache dir required}

lock=$dir/.seed.lock
system=$(uname -m | sed s/arm64/aarch64/)-$(uname -s | tr '[:upper:]' '[:lower:]')
repository=$(jq --exit-status --raw-output .repository "$lock")
digest=$(jq \
  --exit-status \
  --raw-output \
  --arg s "$system" \
  '.systems[$s] // error("no seed digest for \($s)")' \
  "$lock")

blobs=$layout/blobs/sha256
manifest=$blobs/${digest#sha256:}

# cache miss: fetch from ghcr into a local oci layout (preserves the
# exact manifest) for actions/cache to save; oras is only needed here,
# the hot path below runs on preinstalled tools.
if [[ ! -f $manifest ]]; then
  "$GITHUB_ACTION_PATH"/bin/install-oras
  [[ -z ${REGISTRY_USER:-} ]] || oras login "${repository%%/*}" \
    --username "$REGISTRY_USER" --password-stdin <<<"$REGISTRY_PASS"
  oras cp --to-oci-layout "$repository@$digest" "$layout:pull"
fi

# verify the manifest against the lock digest, then each blob against
# the manifest, so a corrupt or poisoned cache entry is rejected. the
# blobs are then used in place (symlinked, mounted directly): no copy.
sha256sum --check --quiet <<<"${digest#sha256:}  $manifest"
mkdir -p "$out"
jq --raw-output '
  .layers[]
  | "\(.digest | ltrimstr("sha256:"))  \(
      .annotations["org.opencontainers.image.title"]
        // error("untitled layer"))"' \
  "$manifest" |
  while read -r hex name; do
    sha256sum --check --quiet <<<"$hex  $blobs/$hex"
    ln -sf "$blobs/$hex" "$out/$name"
  done
