#!/usr/bin/env bash

set -eux -o pipefail

dir=${1:-.}

lock=$dir/.seed.lock
seed=$(jq \
  --exit-status \
  --raw-output \
  --arg system "$(uname -m | sed s/arm64/aarch64/)-$(uname -s | tr '[:upper:]' '[:lower:]')" \
  '"\(.repository)@\(.systems[$system] // error("no seed digest for \($system)"))"' \
  $lock)

# rootful podman: native kernel overlayfs applies the ~3GB image far
# faster than rootless fuse-overlayfs. build must also run rootful to
# share this storage. drop-in (not the main conf) avoids clobbering a
# pre-existing [engine] table; default is 6 concurrent blob downloads.
sudo mkdir -p /etc/containers/containers.conf.d
printf '[engine]\nimage_parallel_copies = 32\n' \
  | sudo tee /etc/containers/containers.conf.d/99-nix-seed.conf >/dev/null

sudo podman pull --creds $REGISTRY_USER:$REGISTRY_PASS $seed
