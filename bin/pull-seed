#!/usr/bin/env bash
# shellcheck disable=2086

set -eux -o pipefail

dir=${1:-.}
out=${2:?artifact output dir required}
layout=${3:?oci layout cache dir required}

lock=$dir/.seed.lock
system=$(uname -m | sed s/arm64/aarch64/)-$(uname -s | tr '[:upper:]' '[:lower:]')
repository=$(jq --exit-status --raw-output .repository "$lock")
digest=$(jq \
  --exit-status \
  --raw-output \
  --arg s "$system" \
  '.systems[$s] // error("no seed digest for \($s)")' \
  "$lock")

# cache miss: fetch from ghcr into a local oci layout (preserves the
# exact manifest) for actions/cache to save. keyed by digest upstream,
# so a hit restores this same layout and skips the network.
if [[ ! -f $layout/index.json ]]; then
  [[ -z ${REGISTRY_USER:-} ]] || oras login "${repository%%/*}" \
    --username "$REGISTRY_USER" --password-stdin <<<"$REGISTRY_PASS"
  oras cp --to-oci-layout "$repository@$digest" "$layout:pull"
fi

# extract by digest: verifies the layout content against $digest whether
# it came from ghcr or the cache, so a poisoned cache entry is rejected.
mkdir -p "$out"
oras pull --oci-layout "$layout@$digest" --output "$out"
