#!/usr/bin/env bash
# shellcheck disable=2086

set -eu -o pipefail

# {{{ getopt

seedAttr=seed
registry=ghcr.io
imageName=

usage() {
  cat <<EOF
Usage:
  build-seed [ PATH ]
Options:
  --seed-attr SEED_ATTR
    name of the seed package attr (default: $seedAttr)
  --registry REGISTRY
    target registry (default: $registry)
  --image-name IMAGE_NAME
    repository to push, e.g. org/nix-seed
    (default: <gh repo nameWithOwner>/<PATH relative to repo root>)
  --tag TAG
    add an extra tag such as IMAGE_NAME:latest
Args:
  PATH  path to flake (default=.)
EOF
}

PARSED=$(
  getopt \
    --options '' \
    --long seed-attr:,registry:,image-name:,tag: \
    -- "$@"
) || {
  usage
  exit 1
}
eval set -- "$PARSED"

tags=()
while true; do
  case "$1" in
  --seed-attr)
    seedAttr=$2
    shift 2
    ;;
  --registry)
    registry=$2
    shift 2
    ;;
  --image-name)
    imageName=$2
    shift 2
    ;;
  --tag)
    tags+=("$2")
    shift 2
    ;;
  --)
    shift
    break
    ;;
  *)
    usage
    exit 1
    ;;
  esac
done

if [[ $# -gt 1 ]]; then
  usage
  exit 1
fi

dir=${1:-.}
[[ $dir =~ ^/ ]] || dir=./$dir

if [[ -z $imageName ]]; then
  command -v gh >/dev/null || {
    echo >&2 "<gh> github command line client required to resolve image name"
    exit 1
  }
  repository=$(cd $dir && gh repo view --json nameWithOwner --jq .nameWithOwner)
  # path of $dir relative to the repo root ("" at the root)
  rel=$(git -C $dir rev-parse --show-prefix)
  imageName=$repository${rel:+/${rel%/}}/seed
fi
# ghcr requires lowercase repository names
imageName=${imageName,,}
repository=$registry/$imageName

# }}}

# {{{ sanity check

[[ -n ${REGISTRY_USER:-} && -n ${REGISTRY_PASS:-} ]] || {
  echo >&2 "REGISTRY_USER and REGISTRY_PASS must be set"
  exit 1
}

# }}}

seed=$dir#$seedAttr
lock=$dir/.seed.lock

name=$(nix eval --raw $seed.name)
tag=$(nix eval --raw $seed.tag)
system=$(nix eval --impure --raw --expr builtins.currentSystem)

# build the squashfs seed (store.squashfs + registration + nix.conf)
out=$(nix build --print-build-logs --no-link --print-out-paths $seed)
echo "Built seed $name:$tag"

# {{{ push

tags+=(
  "$tag"
  #  "$(git -C $dir describe --tags --always --dirty)"
)

# push the seed as an OCI artifact (not an image): plain blobs, no
# engine, no layer extraction on the consumer.
oras login "$registry" --username "$REGISTRY_USER" --password-stdin \
  <<<"$REGISTRY_PASS"
(
  cd "$out"
  oras push "$repository:$tag" \
    store.erofs:application/vnd.nix-seed.erofs \
    registration:application/vnd.nix-seed.registration \
    nix.conf:application/vnd.nix-seed.nixconf
)
digest=$(oras resolve "$repository:$tag")
# extra tags: retag the same manifest, no re-upload
for t in "${tags[@]}"; do
  [[ $t == "$tag" ]] || oras tag "$repository@$digest" "$t"
done
echo "pushed $repository@$digest"

# warm the consumer cache: copy the just-pushed manifest (byte-identical,
# same digest) into an oci layout for actions/cache to save, and emit the
# digest so the seed action keys the cache by it.
if [[ -n ${SEED_CACHE:-} ]]; then
  oras cp --to-oci-layout "$repository@$digest" "$SEED_CACHE:pull"
  echo "key=${digest#sha256:}" >>"${GITHUB_OUTPUT:-/dev/null}"
fi

# }}}

# {{{ update seed lock

# fresh object: drops legacy keys, and a tag change invalidates the
# recorded digests of the other systems
update_lock() {
  [[ -f $lock ]] || printf '{}\n' >$lock
  jq --sort-keys \
    --arg repository "$repository" --arg tag "$tag" \
    --arg system "$system" --arg digest "$digest" \
    '{
      repository: $repository,
      tag: $tag,
      systems: ((if .tag == $tag then .systems else {} end) // {}
        | .[$system] = $digest)
    }' $lock >$lock.tmp
  mv $lock.tmp $lock
}

git=(git -C $dir)
"${git[@]}" config user.email >/dev/null || git+=(
  -c user.name='github-actions[bot]'
  -c user.email='41898282+github-actions[bot]@users.noreply.github.com'
)
# CI checkouts are detached, so the branch cannot be read from HEAD
branch=${GITHUB_REF_NAME:-$("${git[@]}" branch --show-current)}

# parallel per-system builds race on the push: rebuild the lock on top
# of the freshly pulled state each attempt
committed=
for _ in 1 2 3 4 5; do
  "${git[@]}" pull --rebase origin $branch
  update_lock
  "${git[@]}" add .seed.lock
  if "${git[@]}" diff --cached --quiet; then
    committed=1 # nothing new to record
    break
  fi
  "${git[@]}" commit --message "chore(seed): lock $system"
  if "${git[@]}" push origin HEAD:$branch; then
    committed=1
    break
  fi
  # lost the race: drop the commit and our lock edit, then retry
  "${git[@]}" reset HEAD^
  if [[ -n $("${git[@]}" ls-files .seed.lock) ]]; then
    "${git[@]}" checkout -- .seed.lock
  else
    rm $lock
  fi
done
[[ -n $committed ]] || {
  echo >&2 "build-seed: could not push $lock"
  exit 1
}
echo "seed.lock: $repository:$tag $system = $digest"

# }}}
