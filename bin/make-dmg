#!/usr/bin/env bash
# darwin only. Assemble a seed disk image from the staging tree mkSeed
# produced (store-paths, registration, env, nar-size).
#
# This exists outside the nix sandbox because hdiutil needs
# diskarbitrationd, which the sandbox does not provide. Everything the
# image *contains* is still determined by evaluation -- closureInfo
# decides the path list -- so only the packaging escapes. See
# DESIGN.md#macos.
#
# The image is the whole of /nix, not just the store: the consumer
# attaches it at /nix with a shadow file, so one mount and one
# copy-on-write layer cover both the store and the database.

set -eu -o pipefail

stage=${1:?staging directory required}
out=${2:?output .dmg path required}

# ULFO (lzfse) on measurement, not on principle. lzma does compress
# better -- ~27% smaller blobs across all seven examples -- and the
# reasonable guess was that this would pay off on darwin, where an
# actions/cache entry restores at roughly 50 MB/s against roughly
# 234 MB/s on linux. It does not. At n=5 per example the consumer's
# restore-and-mount step was unchanged (median deltas -3s..+3s, mean
# under a second), while lzma cost 50-200s more per darwin seed. python
# makes the point: its ULFO blob is 237MB larger and its step is 5s
# faster.
# So the step is not purely transfer-bound; decompression on read gives
# back what the smaller transfer saves. Set SEED_DMG_FORMAT=ULMO if
# cache or registry storage is the binding constraint rather than time.
#
# UDRO (uncompressed) under test: attaching rust's ULFO image took
# 22-28s in every round against 6-11s for python's larger one, so the
# cost tracks the volume's metadata, not its bytes -- and each metadata
# read on a compressed image decompresses a chunk. -noautofsck did not
# move it (run 33892039949).
format=${SEED_DMG_FORMAT:-UDRO}

work=$(mktemp -d)
mnt=$work/mnt
cleanup() {
  # detach before removing, or the sparse image stays attached and the
  # next run collides on the volume name
  hdiutil detach "$mnt" -force >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT

# size the sparse image from the closure's total nar size, with headroom
# for filesystem overhead. sparse means unused blocks cost nothing, so
# being generous here is free.
narsize=$(cat "$stage/nar-size")
megs=$((narsize * 3 / 2000000 + 512))

# a case-sensitive filesystem is mandatory: the store holds paths that
# differ only in case, and APFS defaults to case-insensitive.
hdiutil create -size "${megs}m" -fs 'Case-sensitive APFS' \
  -volname NixSeed -type SPARSE -o "$work/rw"
hdiutil attach "$work/rw.sparseimage" -mountpoint "$mnt" \
  -owners off -nobrowse -noautoopen

mkdir -p "$mnt/store" "$mnt/var/nix" "$mnt/.seed"

# ditto preserves modes and symlinks; store paths land under store/ by
# basename, so the volume mounted at /nix *is* /nix/store.
while read -r p; do
  [[ -n $p ]] || continue
  ditto "$p" "$mnt/store/${p##*/}"
done <"$stage/store-paths"

cp "$stage/registration" "$mnt/.seed/registration"
# an absolute symlink into the store, resolved once the image is
# attached at /nix -- the same contract as the squashfs pseudo-entry.
ln -s "$(readlink "$stage/env")" "$mnt/.seed/env"

hdiutil detach "$mnt"

mkdir -p "$(dirname "$out")"
rm -f "$out"
hdiutil convert "$work/rw.sparseimage" -format "$format" -o "$out"
# hdiutil appends .dmg when the output has no extension it recognises
[[ -f $out ]] || mv "$out.dmg" "$out"

echo >&2 "built $out ($format, $(du -h "$out" | cut -f1))"
