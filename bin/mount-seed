#!/usr/bin/env bash
# shellcheck disable=2086
# fetch, verify, and mount the squashfs seed as /nix/store: pull the OCI
# blobs (cache or ghcr), verify them against the lock digest, mount the
# squashfs read-only under a writable overlay, register the baked closure
# in a fresh nix db, and put the seeded toolchain on PATH. after this the
# store is ready for the caller's own `nix build`: the seeded nix is on
# PATH, the store belongs to the caller, and the baked nix.conf has no
# substituters, so a build reaches nothing but the mounted closure. that
# is configuration, not confinement -- wrap the build in `unshare --net`
# if the offline property has to be enforced rather than configured.

set -eux -o pipefail

dir=${1:-.}
out=${2:?artifact output dir required}
layout=${3:?oci layout cache dir required}
# full seed digest (sha256:...) for this system, computed once by the
# action's `seed digest` step; avoids re-reading .seed.lock per system.
digest=${4:?seed digest required}
# lock file naming the seed image and its per-system digests
lock=${5:-$dir/.seed.lock}

repository=$(jq --exit-status --raw-output .repository "$lock")

blobs=$layout/blobs/sha256
manifest=$blobs/${digest#sha256:}

# cache miss: fetch from ghcr into a local oci layout (preserves the
# exact manifest) for actions/cache to save; oras is only needed here,
# the hot path below runs on preinstalled tools.
if [[ ! -f $manifest ]]; then
  "$GITHUB_ACTION_PATH"/bin/install-oras
  [[ -z ${REGISTRY_USER:-} ]] || oras login "${repository%%/*}" \
    --username "$REGISTRY_USER" --password-stdin <<<"$REGISTRY_PASS"
  oras cp --to-oci-layout "$repository@$digest" "$layout:pull"
fi

# verify the manifest against the lock digest, then each blob against
# the manifest, so a corrupt or poisoned cache entry is rejected. the
# blobs are then used in place (symlinked, mounted directly): no copy.
# openssl: hardware sha256 (~2GB/s); the runner's coreutils sha256sum
# is scalar (~250MB/s) and would dominate the hot path.
verify() {
  local got
  got=$(openssl dgst -sha256 -r "$2")
  [[ ${got%% *} == "$1" ]] || {
    echo "seed: digest mismatch for $2" >&2
    return 1
  }
}

verify "${digest#sha256:}" "$manifest"
mkdir -p "$out"
jq --raw-output '
  .layers[]
  | "\(.digest | ltrimstr("sha256:"))  \(
      .annotations["org.opencontainers.image.title"]
        // error("untitled layer"))"' \
  "$manifest" |
  while read -r hex name; do
    verify "$hex" "$blobs/$hex"
    ln -sf "$blobs/$hex" "$out/$name"
  done

# mount the baked store read-only under a writable layer, so the build
# can add to it without ever rewriting it. no extraction either way:
# mounting is O(1) in closure size and blocks decompress on demand.
# the two platforms spell that the same way with different tools, and
# `.seed/` therefore lands in a different place on each.
# see DESIGN.md#delivery and DESIGN.md#macos.
if [[ $(uname -s) == Darwin ]]; then

  # /nix cannot simply be created: the root volume is sealed. a
  # synthetic.conf entry plus `apfs.util -t` materialises it as an empty
  # directory to mount over, with no reboot. (-t is macOS 26's spelling;
  # older releases use -B.)
  if [[ ! -d /nix ]]; then
    printf 'nix\n' | sudo tee -a /etc/synthetic.conf >/dev/null
    util=/System/Library/Filesystems/apfs.fs/Contents/Resources/apfs.util
    # judged by the postcondition, not the exit status: -t creates the
    # synthetic entity but still reports failure, and the spelling
    # differs by release (-t on macOS 26, -B before). the directory
    # appearing is the only thing that actually matters.
    sudo "$util" -t 2>/dev/null || sudo "$util" -B 2>/dev/null || true
    for _ in 1 2 3 4 5; do
      [[ -d /nix ]] && break
      sleep 1
    done
  fi
  [[ -d /nix ]] || {
    echo "mount-seed: /nix does not exist and could not be created." >&2
    echo "the root volume is sealed, so a synthetic.conf entry plus" >&2
    echo "apfs.util is the only way to get a mountpoint." >&2
    exit 1
  }

  # -shadow is the writable layer: the base image stays read-only and
  # every write lands in a sparse file beside it. copy-on-write at the
  # block layer, which is what macOS has instead of overlayfs.
  # -owners off presents the volume as owned by the mounting user, so
  # nix runs unprivileged for the rest of the job exactly as on linux.
  # -noautofsck skips fsck_apfs before mounting: it walks every inode,
  # which cost 23s on a closure-sized volume, and the image is
  # read-only under the shadow so there is nothing for it to repair.
  sudo hdiutil attach "$out/store.dmg" \
    -shadow "${RUNNER_TEMP:-/tmp}/seed.shadow" \
    -mountpoint /nix \
    -owners off -nobrowse -noautoopen -noverify -noautofsck

  seedmeta=/nix/.seed

else

  sudo mkdir -p /nix/.ro-store /nix/.rw/upper /nix/.rw/work /nix/store /nix/var/nix
  sudo mount -t squashfs -o loop,ro "$out/store.squashfs" /nix/.ro-store
  sudo mount -t overlay overlay \
    -o lowerdir=/nix/.ro-store,upperdir=/nix/.rw/upper,workdir=/nix/.rw/work \
    /nix/store

  # hand the store to the caller. nix then runs unprivileged for the rest
  # of the job: no sudo in the consumer's build, no root-owned artifacts in
  # the workspace, and no dubious-ownership fight between root's libgit2
  # and a checkout the runner user owns.
  # chowning the merged mount point copies the root directory up into the
  # overlay with the new ownership -- the baked paths underneath stay
  # root-owned and read-only, which is all a store needs them to be.
  # (darwin gets the same effect from -owners off, above.)
  sudo chown "$(id -u):$(id -g)" /nix/store /nix/.rw/upper /nix/.rw/work
  sudo chown -R "$(id -u):$(id -g)" /nix/var

  seedmeta=/nix/.ro-store/.seed

fi

# expose the seeded toolchain (buildEnv at .seed/env) on PATH for later
# job steps. the symlink resolves through the mounted store.
seedenv=$seedmeta/env
envbin=$seedenv/bin
[[ -z ${GITHUB_PATH:-} ]] || echo $envbin >>"$GITHUB_PATH"

# link in seed nix.conf BEFORE touching the db: it sets
# fsync-metadata = false, which load-db must see: a fsync per registered
# record otherwise dominates the mount.
sudo mkdir -p /etc/nix
sudo ln -sf $seedenv/etc/nix/nix.conf /etc/nix/nix.conf

# nix comes from the mounted store; register the baked closure as valid.
# registration lives under .seed/ in the image, alongside the store
# rather than inside it: it is seed metadata, not a store path.
# unprivileged now that the store belongs to the caller, so the db it
# creates is owned by the user who will go on to build against it.
"$envbin/nix-store" --load-db <"$seedmeta/registration"
