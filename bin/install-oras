#!/usr/bin/env bash
# install oras (the consumer's only bootstrap tool: it pulls the seed
# artifact before the nix store is mounted). a single static binary.

set -eu -o pipefail

command -v oras >/dev/null && exit 0

version=1.3.3
arch=$(dpkg --print-architecture) # amd64 | arm64
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

curl --fail --silent --show-error --location \
  "https://github.com/oras-project/oras/releases/download/v$version/oras_${version}_linux_${arch}.tar.gz" |
  tar -xz -C "$tmp" oras
sudo install "$tmp/oras" /usr/local/bin/oras
hash -r
