#!/usr/bin/env bash
# install oras (the consumer's only bootstrap tool: it pulls the seed
# artifact before the nix store is mounted). a single static binary.

set -eu -o pipefail

command -v oras >/dev/null && exit 0

version=1.3.3
# uname, not dpkg: the latter is Debian-only and absent on macOS. oras
# publishes linux and darwin builds for both architectures.
os=$(uname -s | tr '[:upper:]' '[:lower:]') # linux | darwin
case $(uname -m) in
x86_64 | amd64) arch=amd64 ;;
aarch64 | arm64) arch=arm64 ;;
*)
  echo >&2 "install-oras: unsupported architecture $(uname -m)"
  exit 1
  ;;
esac
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

curl --fail --silent --show-error --location \
  "https://github.com/oras-project/oras/releases/download/v$version/oras_${version}_${os}_${arch}.tar.gz" |
  tar -xz -C "$tmp" oras
sudo install "$tmp/oras" /usr/local/bin/oras
