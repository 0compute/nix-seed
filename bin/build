#!/usr/bin/env bash

set -eu -o pipefail

dir=${1:-.}
[[ $dir =~ ^/ ]] || dir=./$dir

installable=$dir
lock=$dir/.seed.lock

# TODO: handle no seed case
seed=$(jq \
  --exit-status \
  --raw-output \
  --arg system "$(uname -m | sed s/arm64/aarch64/)-$(uname -s | tr '[:upper:]' '[:lower:]')" \
  '"\(.repository)@\(.systems[$system] // error("no seed digest for \($system)"))"' \
  $lock)

# private registries: login when credentials are provided
if [[ -n ${REGISTRY_USER:-} && -n ${REGISTRY_PASS:-} ]]; then
  podman login "${seed%%/*}" \
    --username "$REGISTRY_USER" \
    --password-stdin \
    <<<"$REGISTRY_PASS"
fi

# host directory the build result (and its closure) is exported to.
out=${2:-$PWD/result-out}
rm -rf $out
mkdir -p "$out"

link=/tmp/result

PODMAN=(
  podman
  run
  --network none
  --tmpfs /tmp
  --rm
  -i
  --volume $PWD:/src
  --volume "$out":/out
  $seed
)

# build offline, then export the result closure to /out as a file-based
# binary cache (nar + narinfo) that survives the --rm container.
"${PODMAN[@]}" sh -c \
  "nix build --offline --out-link $link /src/$installable \
   && nix copy --offline --no-check-sigs --to file:///out $link \
   && cp -a $link /src/result"

nix copy --no-check-sigs --all --from file://$out
