#!/usr/bin/env bash
# shellcheck disable=2086
# build a project offline from the already-mounted squashfs seed store
# (mounted by bin/mount-seed). nix runs as root (single-user model) inside
# a network namespace (`unshare -n`), so the build is hermetic with no
# substituters and no network.

set -eux -o pipefail

dir=${1:-.}
[[ $dir =~ ^/ ]] || dir=./$dir

manifest=/nix/.ro-store/.seed/drvs.json

# drv-baked seed (see doc/drv-seeds.md): the recipe closure is baked and
# registered, so realise it directly -- zero evaluation, which is why such
# seeds carry no flake-input sources. no evaluator also means no libgit2
# (no safe.directory) and no boehm GC to disable.
if drv=$(jq -er .default.drv "$manifest" 2>/dev/null); then

  if src=$(jq -er .default.src "$manifest" 2>/dev/null); then
    # hash the checkout (tracked files, approximating the flake source
    # filter) and graft it onto the baked recipe when it drifted; the
    # identity case realises the baked drv untouched. identity is CONTENT
    # (nar hash): the seeded src may be a subpath of a larger source
    # tree, so store paths cannot be compared.
    name=$(jq -er .default.srcName "$manifest")
    prefix=$(git -C "$dir" rev-parse --show-prefix)
    tmp=$(mktemp -d)
    git -C "$dir" archive "HEAD${prefix:+:$prefix}" | tar -x -C "$tmp"
    if [[ $("$(command -v nix)" hash path "$tmp") != $("$(command -v nix)" hash path "$src") ]]; then
      # store-writing steps run as root: the mounted store's db was
      # loaded under sudo. explicit PATH assignment survives secure_path.
      new=$(sudo env "PATH=$PATH" "$(command -v nix)" store add-path --name "$name" "$tmp")
      drv=$(sudo env "PATH=$PATH" "$(dirname "$0")"/regraft "$drv" "$src" "$new")
    fi
  fi
  sudo env HOME=/tmp unshare --net \
    "$(command -v nix-store)" --realise "$drv"

else

  # sources mode: offline flake evaluation + build.
  # nix runs as root; /src (the checkout) is owned by the runner user, so
  # its libgit2 flake fetcher rejects it -> mark it a safe directory.
  printf '[safe]\n\tdirectory = *\n' | sudo tee -a /etc/gitconfig >/dev/null

  # unshare -n drops all network (only loopback) -> hermetic build.
  # GC_DONT_GC: skip the boehm GC during evaluation, ~10-25% faster eval;
  # the process is short-lived so peak memory is irrelevant.
  sudo \
    env \
    HOME=/tmp \
    GC_DONT_GC=1 \
    unshare --net \
    "$(command -v nix)" build --offline --no-link --print-out-paths "$dir"

fi
