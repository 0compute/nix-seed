#!/usr/bin/env bash

set -eux -o pipefail

dir=${1:-.}
[[ $dir =~ ^/ ]] || dir=./$dir

installable=$dir

# image loaded into rootful storage by pull-seed under this fixed tag
tag=localhost/nix-seed/seed:pull

# rootful to share storage with the rootful load in pull-seed. the
# container runs as root while /src is owned by the runner user, so
# nix's libgit2 flake fetcher rejects it; mark it safe. git is not in
# the seed, so write the global config directly (HOME=/tmp, a tmpfs).
sudo podman run \
  --network none \
  --tmpfs /tmp \
  --rm \
  --interactive \
  --volume $PWD:/src \
  $tag \
  sh -c 'printf "[safe]\n\tdirectory = *\n" >"$HOME/.gitconfig" && exec nix build --offline /src/'"$installable"
