#!/usr/bin/env bash

set -eux -o pipefail

dir=${1:-.}
[[ $dir =~ ^/ ]] || dir=./$dir

installable=$dir
lock=$dir/.seed.lock

# TODO: handle no seed case
seed=$(jq \
  --exit-status \
  --raw-output \
  --arg system "$(uname -m | sed s/arm64/aarch64/)-$(uname -s | tr '[:upper:]' '[:lower:]')" \
  '"\(.repository)@\(.systems[$system] // error("no seed digest for \($system)"))"' \
  $lock)

# rootful to share storage with the rootful pull in pull-seed
sudo podman run \
  --network none \
  --tmpfs /tmp \
  --rm \
  --interactive \
  --volume $PWD:/src \
  $seed \
  nix build --offline /src/$installable
